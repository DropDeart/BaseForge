<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>baseforge</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageId>BaseForge.CodeGen</PackageId>
    <Description>BaseForge kod üretici: YAML servis spec'inden mikroservis iskelesi (Entity, DbContext, CQRS CRUD, Controller, Program.cs, Dockerfile) ve draw.io ER diyagramı üretir. `dotnet tool` olarak çalışır.</Description>
    <!-- Konsol aracı: public API doc'u gerekmez; YAML'a deserialize edilen spec sınıfları için analiz gevşetildi -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA2227;CA1812;CA1031</NoWarn>
  </PropertyGroup>

  <!-- Designer arayüzü minimal API host'u için ASP.NET Core paylaşılan framework'ü -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Scriban" Version="7.2.5" />
    <PackageReference Include="YamlDotNet" Version="18.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BaseForge.CodeGen.Contracts\BaseForge.CodeGen.Contracts.csproj" />
  </ItemGroup>

  <!-- Identity referans servisi dosyaları: new-identity için gömülü şablon (tek doğru kaynak).
       Üretimde 'BaseForge.Identity' namespace'i kullanıcının servis adıyla değiştirilir. -->
  <ItemGroup>
    <!-- Workspace'e üretilen Loki + Grafana (observability/): repo kökündeki grafana/ tek kaynak. -->
    <EmbeddedResource Include="..\..\grafana\loki-config.yaml" LogicalName="observability/grafana/loki-config.yaml" />
    <EmbeddedResource Include="..\..\grafana\provisioning\datasources\loki.yaml" LogicalName="observability/grafana/provisioning/datasources/loki.yaml" />
    <EmbeddedResource Include="..\..\grafana\provisioning\dashboards\dashboards.yaml" LogicalName="observability/grafana/provisioning/dashboards/dashboards.yaml" />
    <EmbeddedResource Include="..\..\grafana\dashboards\baseforge-logs.json" LogicalName="observability/grafana/dashboards/baseforge-logs.json" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Program.cs" LogicalName="identity/Program.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Configuration\AuthOptions.cs" LogicalName="identity/Configuration/AuthOptions.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Entities\ApplicationUser.cs" LogicalName="identity/Entities/ApplicationUser.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Data\IdentityServiceDbContext.cs" LogicalName="identity/Data/IdentityServiceDbContext.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Data\SeedData.cs" LogicalName="identity/Data/SeedData.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Data\PostgresHealthCheck.cs" LogicalName="identity/Data/PostgresHealthCheck.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Controllers\AuthorizationController.cs" LogicalName="identity/Controllers/AuthorizationController.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Controllers\AccountApiController.cs" LogicalName="identity/Controllers/AccountApiController.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Controllers\AdminUsersApiController.cs" LogicalName="identity/Controllers/AdminUsersApiController.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Controllers\ServicesApiController.cs" LogicalName="identity/Controllers/ServicesApiController.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Authentication\ExternalProviders.cs" LogicalName="identity/Authentication/ExternalProviders.cs" />
    <!-- Merkez kullanıcı (User) gRPC servisi: new-identity için kopyalanır. Aynı "identity/Protos/user.proto"
         kaynağı, "identity/User" dış referansı çözümlenirken CodeGenerator tarafından da doğrudan okunur
         (tek fiziksel kaynak, tek LogicalName — SDK aynı yolu iki LogicalName ile içermeyi reddediyor). -->
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Protos\user.proto" LogicalName="identity/Protos/user.proto" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Grpc\UserGrpcService.cs" LogicalName="identity/Grpc/UserGrpcService.cs" />
    <!-- Profil yardımcıları (şemadan bağımsız). UserProfile.cs, ApplicationUser.Profile.cs ve user.proto ise
         auth.yaml userProfile'dan üretilir (UserProfileGenerator); repodaki kopyaları boş profil çıktısıdır. -->
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Profile\ProfileJson.cs" LogicalName="identity/Profile/ProfileJson.cs" />
    <!-- Hesap: dış giriş, OTP (SMS/e-posta) ve doğrulama (0.6.4). -->
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Configuration\RequireFeatureAttribute.cs" LogicalName="identity/Configuration/RequireFeatureAttribute.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Contacts\ContactNormalizer.cs" LogicalName="identity/Contacts/ContactNormalizer.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Messaging\MessageSenders.cs" LogicalName="identity/Messaging/MessageSenders.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Accounts\AccountRegistration.cs" LogicalName="identity/Accounts/AccountRegistration.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Accounts\ContactVerificationService.cs" LogicalName="identity/Accounts/ContactVerificationService.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Accounts\ExternalAccountService.cs" LogicalName="identity/Accounts/ExternalAccountService.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Accounts\OptionalEmailValidator.cs" LogicalName="identity/Accounts/OptionalEmailValidator.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Accounts\RegistrationRoles.cs" LogicalName="identity/Accounts/RegistrationRoles.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Otp\OtpChallenge.cs" LogicalName="identity/Otp/OtpChallenge.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Otp\OtpCode.cs" LogicalName="identity/Otp/OtpCode.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Otp\OtpModel.cs" LogicalName="identity/Otp/OtpModel.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Otp\OtpRegistration.cs" LogicalName="identity/Otp/OtpRegistration.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Otp\OtpService.cs" LogicalName="identity/Otp/OtpService.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Controllers\VerificationApiController.cs" LogicalName="identity/Controllers/VerificationApiController.cs" />
    <!-- Kiracı (şirket) yönetimi ve /api hata middleware'i (0.6.4). -->
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\ErrorHandling\IdentityException.cs" LogicalName="identity/ErrorHandling/IdentityException.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\ErrorHandling\IdentityExceptionMiddleware.cs" LogicalName="identity/ErrorHandling/IdentityExceptionMiddleware.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Tenancy\Tenant.cs" LogicalName="identity/Tenancy/Tenant.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Tenancy\TenantMembership.cs" LogicalName="identity/Tenancy/TenantMembership.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Tenancy\TenancyModel.cs" LogicalName="identity/Tenancy/TenancyModel.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Tenancy\TenancyText.cs" LogicalName="identity/Tenancy/TenancyText.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Tenancy\TenancyDtos.cs" LogicalName="identity/Tenancy/TenancyDtos.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Tenancy\TenantAdminGuard.cs" LogicalName="identity/Tenancy/TenantAdminGuard.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Tenancy\TenantOnboardingService.cs" LogicalName="identity/Tenancy/TenantOnboardingService.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Tenancy\MembershipService.cs" LogicalName="identity/Tenancy/MembershipService.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Tenancy\MemberAdministrationService.cs" LogicalName="identity/Tenancy/MemberAdministrationService.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Tenancy\TenantTokenResolver.cs" LogicalName="identity/Tenancy/TenantTokenResolver.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Tenancy\TenancyRegistration.cs" LogicalName="identity/Tenancy/TenancyRegistration.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Controllers\TenantsApiController.cs" LogicalName="identity/Controllers/TenantsApiController.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Controllers\TenantMembersApiController.cs" LogicalName="identity/Controllers/TenantMembersApiController.cs" />
    <EmbeddedResource Include="..\..\services\BaseForge.Identity\Controllers\AdminTenantsApiController.cs" LogicalName="identity/Controllers/AdminTenantsApiController.cs" />
  </ItemGroup>

  <!-- Designer React arayüzü: npm build çıktısını (dist) 'web/...' logical name'leriyle gömer.
       DesignerServer içindeki EmbeddedWebFileProvider bu resource'ları sunar.
       Node yoksa veya arayüz gerekmiyorsa: dotnet build -p:SkipWebBuild=true -->
  <PropertyGroup>
    <DesignerWebDir>$(MSBuildThisFileDirectory)..\BaseForge.Designer.Web</DesignerWebDir>
  </PropertyGroup>

  <Target Name="BuildDesignerWeb"
          BeforeTargets="PrepareForBuild;CoreCompile"
          Condition="'$(SkipWebBuild)' != 'true'">
    <Message Importance="high" Text="BaseForge Designer arayüzü derleniyor (npm)…" />
    <Exec Command="npm ci" WorkingDirectory="$(DesignerWebDir)"
          Condition="!Exists('$(DesignerWebDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(DesignerWebDir)" />
    <!-- Önce özel item tipine topla (EmbeddedResource üzerinde %() batch tuzağından kaçın),
         sonra oradan transform ederek web/<yol> logical name'iyle göm. -->
    <ItemGroup>
      <_DesignerWebDist Include="$(DesignerWebDir)\dist\**\*" />
      <EmbeddedResource Include="@(_DesignerWebDist)">
        <LogicalName>web/$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\','/'))</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <!-- Ortak Giriş SPA'sı (Login/Register/Admin, identity servisi için): npm build çıktısını
       'identity-web/...' logical name'leriyle gömer. IdentityGenerator üretim sırasında bunları
       <output>/wwwroot altına kopyalar. -->
  <PropertyGroup>
    <IdentityWebDir>$(MSBuildThisFileDirectory)..\..\services\BaseForge.Identity.Web</IdentityWebDir>
  </PropertyGroup>

  <!-- 'dotnet pack' Build/Publish/Pack adımları için bu csproj'u birden çok kez (bazen üst üste
       binen zamanlamalarla) derler. npm build burada tetiklenseydi, bir geçişin 'dist'i silip yeniden
       yazması başka bir geçişin o an okuduğu dosyayı yok edebiliyordu (CS1566, tekrarlayan yarış durumu).
       Bu yüzden npm build BURADA çalıştırılmaz — 'dist' önceden (örn. 'npm run build' ile elle, ya da
       ayrı bir CI adımıyla) üretilmiş olmalı; bu hedef sadece var olan çıktıyı gömer. -->
  <Target Name="BuildIdentityWeb"
          BeforeTargets="PrepareForBuild;CoreCompile"
          Condition="'$(SkipWebBuild)' != 'true'">
    <Error Condition="!Exists('$(IdentityWebDir)\dist\index.html')"
           Text="'$(IdentityWebDir)\dist' bulunamadı. Önce: cd &quot;$(IdentityWebDir)&quot; &amp;&amp; npm run build" />
    <ItemGroup>
      <_IdentityWebDist Include="$(IdentityWebDir)\dist\**\*" />
      <EmbeddedResource Include="@(_IdentityWebDist)">
        <LogicalName>identity-web/$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\','/'))</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
